{
  "name": "paperclip-plugin-webpush",
  "version": "0.13.4",
  "type": "module",
  "description": "Desktop and Android Web Push notifications for Paperclip board events.",
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "dev": "node ./esbuild.config.mjs --watch",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "automation",
    "notifications",
    "webpush"
  ],
  "author": "conreo",
  "license": "MIT",
  "dependencies": {
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@paperclipai/plugin-sdk": "2026.916.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.8",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/conreo/paperclip-plugin-webpush.git"
  },
  "homepage": "https://github.com/conreo/paperclip-plugin-webpush#readme",
  "bugs": {
    "url": "https://github.com/conreo/paperclip-plugin-webpush/issues"
  }
}
